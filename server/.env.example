# 复制为 server/.env 后按需修改，不要提交真实密钥
# 后端启动时会从 server/.env 读取这些变量

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fitplan
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------- 服务 ----------
FITPLAN_API_PORT=8787
FITPLAN_FRONT=http://localhost:5173
# 允许跨域访问 /api 的来源，逗号分隔
FITPLAN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 支付宝异步通知要打得到的公网地址，本地不收款可留空
FITPLAN_PUBLIC_BASE=
FITPLAN_PRO_PRICE_YUAN=8
FITPLAN_PRO_DAYS=30
FITPLAN_PRO_SUBJECT=练 · Pro 会员

# ---------- Redis（登录限流、JWT 黑名单） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- 认证 ----------
# 生产环境必须换成随机长字符串
JWT_SECRET=please-change-this-to-a-random-secret
JWT_EXPIRE_MINUTES=120

# ---------- 初始管理员 ----------
# 仅当数据库里还没有任何 ADMIN 时创建，已有管理员不会被覆盖
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NICKNAME=管理员

# ---------- 支付宝（可选） ----------
# 不配置时只能账号密码登录；下单、退款会明确提示缺少配置
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
